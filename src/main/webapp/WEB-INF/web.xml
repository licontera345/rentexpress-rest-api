<?xml version="1.0" encoding="UTF-8"?>
<!-- Sin servlet explícito: Jersey se registra por Servlet 3.0 (RestApiApplication con @ApplicationPath).
     Si usas servlet en web.xml, en Eclipse asegura Deployment Assembly → Maven Dependencies → WEB-INF/lib. -->
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <resource-ref>
        <description>DB Connection</description>
        <res-ref-name>jdbc/rentexpresDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>
